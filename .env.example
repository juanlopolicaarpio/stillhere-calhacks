# ---- Cartesia (P0: real outbound PSTN call via Managed Agents) ----
# Create at https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Cartesia API version pinned by cartesia-python 4.2.0
CARTESIA_VERSION=2026-08-14
# Managed Agent id (create agent in Playground -> Agents)
CARTESIA_AGENT_ID=
# Phone number id on your Cartesia account (NOT the number itself)
CARTESIA_FROM_NUMBER_ID=
# Voice id for Sonic (browse play.cartesia.ai/voices)
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_TTS_MODEL=sonic-3.6

# ---- Demo target (the judge's / developer's phone, E.164, US) ----
MY_PHONE_E164=

# ---- Anthropic (companion reasoning + memory extraction) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Public base URL for Cartesia tool webhooks (use ngrok/cloudflared) ----
PUBLIC_BASE_URL=http://localhost:8000
# Shared secret Cartesia tool webhooks must present
WEBHOOK_SECRET=dev-only-change-me

# ---- Dashboard protection ----
DASHBOARD_TOKEN=dev-dashboard-token

# ---- Optional: Twilio (number provider / SMS onboarding) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- SpacetimeDB (authoritative real-time coordination backend) ----
# Local server:  spacetime start --listen-addr 127.0.0.1:3000
# Publish module: make stdb
SPACETIMEDB_HOST=http://127.0.0.1:3000
SPACETIMEDB_DB=stillhere
# Leave blank locally to reuse the spacetime CLI's dev token (logged as dev-only).
# Set explicitly for any non-local deployment.
SPACETIMEDB_TOKEN=
# Set to 0 to forbid the local CLI-token fallback entirely.
SPACETIMEDB_ALLOW_CLI_TOKEN=1
